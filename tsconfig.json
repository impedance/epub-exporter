{
  // AICODE-NOTE: DECISION/TS-JSDOC decision: enable TS checking for JS with JSDoc without full TS migration.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules", "jszip.min.js", "test/**", "**/*.test.js"]
}
