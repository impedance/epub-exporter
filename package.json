{
  "name": "epub-exporter",
  "version": "1.0.0",
  "description": "Полнофункциональное Chrome расширение для извлечения контента из веб-страниц и конвертации в формат EPUB, оптимизированный для PocketBook и других электронных читалок.",
  "main": "background.js",
  "scripts": {
    "lint:aicode": "bash scripts/lint-aicode.sh",
    "test": "node --test test/core/*.test.mjs",
    "test:core": "node --test test/core/*.test.mjs",
    "test:full": "node --test test/core/*.test.mjs test/full/*.test.mjs",
    "test:verbose": "node test_runner.js",
    "test:functions": "node --test test/core/epub_generator_helpers.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@types/jszip": "^3.4.0",
    "@types/node": "^25.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3"
  }
}
