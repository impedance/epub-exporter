{
  "manifest_version": 3,
  "name": "EPUB Экспортер",
  "version": "1.1.0",
  "description": "Экспорт контента веб-страниц в формат EPUB для PocketBook с интеграцией Dropbox",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*",
    "https://www.dropbox.com/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Экспорт в EPUB"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/readability.js",
        "lib/dompurify.js",
        "content_script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "epub_generator.js",
        "jszip.min.js",
        "config.js",
        "dropbox_client.js",
        "gmail_client.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "oauth2": {
    "client_id": "YOUR_GMAIL_CLIENT_ID_HERE.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.send"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; default-src 'self'"
  }
}